# Copy to `.env` beside this file. It is read at the root of this checkout only, never from the repository adk-spec
# works in, and a variable already set in the shell wins over it.

# LiteLLM fetches its model map from the network at every import unless told not to.
LITELLM_LOCAL_MODEL_COST_MAP=True

# The arm: copilot (the arm when blank) or gemini.
SPEC_PROVIDER=copilot
# The model within that arm. Blank means the arm's default. One role's own model: SPEC_<ROLE>_MODEL, as SPEC_TRIAGE_MODEL.
SPEC_MODEL=
# A second model behind every role's first, tried on a 429, a 5xx or a timeout. Blank means none.
SPEC_FALLBACK_MODEL=

# Copilot: no key. Run `uv run adk-spec login` once.
# GITHUB_COPILOT_TOKEN_DIR=~/.config/litellm/github_copilot

# Gemini: an AI Studio key, or Vertex AI with a project.
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=global
